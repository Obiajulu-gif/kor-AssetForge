# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/assetforge?sslmode=disable

# Database Connection Pool Settings (#307)
# See docs/DATABASE_TUNING.md for environment-specific sizing guidance
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_WAIT=1s

# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC endpoint (optional; defaults to the public testnet/mainnet endpoint)
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Secret key (S...) used to sign Soroban contract invocations. Never commit this.
STELLAR_SIGNER_SECRET=

# Contract IDs (set after deployment)
# Required: deployed Stellar contract address (56 characters, C..., valid checksum).
SOROBAN_ASSET_TOKEN_CONTRACT_ID=
MARKETPLACE_CONTRACT_ID=

# Server Configuration
SERVER_PORT=8080

# Redis Configuration
REDIS_URL=localhost:6379

# Required in every environment: at least 32 characters, randomly generated.
# Run ./scripts/generate_jwt_secret.sh from the repository root and paste its output.
JWT_SECRET=
# Optional shared CSRF token; generate independently and send as X-CSRF-Token.
CSRF_SECRET=
WEBHOOK_SECRET=your-webhook-secret-here

# Optional: For production
# STELLAR_NETWORK=public
# STELLAR_HORIZON_URL=https://horizon.stellar.org
